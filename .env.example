# QueryQuest environment variables. Copy to `.env.local` for the Next.js app.
# docker-compose reads `.env` (not `.env.local`), so copy the MySQL/runner section
# there if you want to override its dev-only defaults.
#
# Never commit real values. Production values are set in Vercel (app) and Railway (runner).

# --- Next.js app (Vercel) ----------------------------------------------------------
# Public: shipped to the browser. Local values come from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
# Supabase secret key (sb_secret_...) or legacy service_role key. It bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me
# Where the Next.js server reaches the SQL runner, and the shared secret it sends.
RUNNER_URL=http://127.0.0.1:4000
RUNNER_SECRET=replace-with-a-random-string-of-at-least-32-chars

# --- SQL runner + MySQL (docker-compose locally, Railway in production) --------------
# Generate real values with e.g. `openssl rand -base64 32`.
MYSQL_ROOT_PASSWORD=replace-me
RUNNER_ADMIN_USER=qq_admin
RUNNER_ADMIN_PASSWORD=replace-me
# RUNNER_SECRET (above) must be identical in the app and the runner.
